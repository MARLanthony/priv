# ---------------------------------------------------------------------------
# JurisFlow — frontend environment (Vite)
#
#   cp .env.example .env
#
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# The OpenRouter key deliberately is NOT here — it belongs to the backend
# (`backend/.env`), which proxies every AI call through /api/ai/chat.
# ---------------------------------------------------------------------------

# Base URL of the Flask API. The default works with the Vite dev proxy below.
VITE_API_BASE_URL=/api

#   true  = bundled MSW demo data (no backend needed, data resets on reload)
#   false = the real Flask API + Supabase database
VITE_USE_MOCKS=true

# Port the Flask dev server listens on (Vite proxies /api to it).
API_PORT=5000

# ---------------------------------------------------------------------------
# AI latency budget, in milliseconds. Defaults shown.
#   TIMEOUT_MS       per-attempt timeout, then the next model is tried
#   MAX_RETRIES      extra attempts per model (the model chain is already the retry)
#   HEDGE_AFTER_MS   start the next model in parallel after N ms (0 = off)
#   TOTAL_TIMEOUT_MS hard budget for the whole chain, then the local fallback
# ---------------------------------------------------------------------------
VITE_AI_TIMEOUT_MS=60000
VITE_AI_MAX_RETRIES=1
VITE_AI_HEDGE_AFTER_MS=0
VITE_AI_TOTAL_TIMEOUT_MS=120000

# ============================================================================
# JurisFlow · Supabase connection for the Flask backend (copy to .env)
# ----------------------------------------------------------------------------
# Print the real values with `supabase status` after `supabase start`.
# Never commit the service key — .env is git-ignored, .env.example is not.
# ============================================================================

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-me-anon-key
SUPABASE_SERVICE_KEY=replace-me-service-role-key

# Direct Postgres connection used by the API (SQLAlchemy / psycopg).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Storage bucket that holds the uploaded documents.
SUPABASE_STORAGE_BUCKET=documents

# ---------------------------------------------------------------------------
# JurisFlow environment variables (Vite)
#
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# Get a free OpenRouter key at https://openrouter.ai/keys
# Leave VITE_OPENROUTER_API_KEY empty to run in demo/offline mode: the AI layer
# then falls back to the MSW mock data automatically.
#
# Two ways to set the key:
#   1. file   — `npm run env:key -- sk-or-v1-...` rewrites the line below safely
#   2. in app — Settings -> AI engine: stored on the device (localStorage), so it
#               still works if this file is deleted, reverted or never created
#
# Check the current state at any time with `npm run env:check` (the key is masked).
# ---------------------------------------------------------------------------

VITE_OPENROUTER_API_KEY=

# Optional overrides (defaults shown)
VITE_OPENROUTER_HTTP_REFERER=http://localhost:5173
VITE_OPENROUTER_TITLE=JurisFlow

# Latency budget (defaults shown).
# Accuracy comes first: the primary model is allowed to reason, so a single
# attempt gets a generous timeout, and the whole chain is capped so the UI falls
# back to demo data instead of hanging. Lower these to trade accuracy for speed.
# Free-tier note: the free pool queues requests, so a reasoning attempt measured
# ~43s on average. The caps below leave room for the primary to finish AND for one
# hop down the chain, instead of timing the primary out mid-generation.
#   TIMEOUT_MS       per-attempt timeout, then the next model is tried
#   MAX_RETRIES      extra attempts per model (the model chain is already the retry)
#   HEDGE_AFTER_MS   start the next model in parallel after N ms (0 = off; costs 2x quota)
#   TOTAL_TIMEOUT_MS hard budget for the whole chain, then instant MSW/heuristic fallback
VITE_OPENROUTER_TIMEOUT_MS=60000
VITE_OPENROUTER_MAX_RETRIES=1
VITE_OPENROUTER_HEDGE_AFTER_MS=0
VITE_OPENROUTER_TOTAL_TIMEOUT_MS=120000

# ---------------------------------------------------------------------------
# Accounts: where sign-up / login data lives.
#
#   mock  = the bundled MSW demo accounts (offline, nothing is persisted).
#   mysql = the real Flask API in server/ -> your local MySQL. Requires:
#             1. MySQL running      (XAMPP Control Panel -> MySQL -> Start)
#             2. python -m server.setup (creates the database, table + demo login)
#             3. pip install -r requirements.txt
#             4. npm run api        (starts Flask in a second terminal)
#
# Restart `npm run dev` after changing this line.
# ---------------------------------------------------------------------------
VITE_AUTH_BACKEND=mock

# API server + MySQL. These deliberately have NO VITE_ prefix: Vite only inlines
# VITE_-prefixed values, so the database password never reaches the browser.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=jurisflow
API_PORT=4001
# Signing key for session tokens (generate a random secret of at least 32 chars).
AUTH_TOKEN_SECRET=


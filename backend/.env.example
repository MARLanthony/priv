# ============================================================================
# JurisFlow API — environment template
# ----------------------------------------------------------------------------
# Copy to `backend/.env` and fill in. `.env` is git-ignored; this file is not.
# Never put the service key or the OpenRouter key in the frontend.
# ============================================================================

# --- Flask ---------------------------------------------------------------
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET=change-me-too
JWT_EXPIRY_HOURS=12
PORT=5000

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# --- Supabase ------------------------------------------------------------
# Values printed by `supabase status` (local) or found in Project Settings (cloud).
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-me-anon-key
SUPABASE_SERVICE_KEY=replace-me-service-role-key
SUPABASE_STORAGE_BUCKET=documents

# Direct Postgres connection used by psycopg2.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- OpenRouter (AI) ----------------------------------------------------
# The key stays here; the browser only ever calls /api/ai/chat.
OPENROUTER_API_KEY=sk-or-v1-replace-me
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=deepseek/deepseek-r1:free
OPENROUTER_FALLBACK_MODEL=deepseek/deepseek-r1-distill-llama-70b:free
OPENROUTER_APP_NAME=JurisFlow
OPENROUTER_SITE_URL=http://localhost:5173

# --- Uploads -------------------------------------------------------------
# Local fallback used when Supabase Storage is not configured.
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH_MB=25
